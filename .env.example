# NVIDIA build API key — https://build.nvidia.com/settings/api-keys
# Put the real key in .env.local (gitignored), not in this file.
NVIDIA_API_KEY=your_key_here

# Image generation on NVIDIA NIM
IMAGE_GEN_PROVIDER=nvidia          # nvidia | mock
IMAGE_GEN_MOCK=true                # true = placeholder image, no API call
IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
NVIDIA_IMAGE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_STEPS=4

# LLM on NVIDIA NIM (OpenAI-compatible chat)
LLM_PROVIDER=nvidia                # nvidia | mock
LLM_MOCK=true                      # true = canned responses for tests
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_VERIFIER_MODEL=mistralai/mistral-nemotron
NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Storage
OUTPUT_DIR=./sample_output
DB_PATH=./rangmanch.db

# Budget guard
MAX_IMAGE_GENERATIONS=50
MAX_LLM_CALLS_PER_PROJECT=100
